<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Stephanos.RescueIslandCustody/Stephanos.RescueIslandCustody.csproj" />
    <ProjectReference Include="../Stephanos.RescueIslandHost/Stephanos.RescueIslandHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyBuiltHost" AfterTargets="Build">
    <ItemGroup>
      <BuiltHost Include="../Stephanos.RescueIslandHost/bin/$(Configuration)/net8.0-windows/*" />
    </ItemGroup>
    <Copy SourceFiles="@(BuiltHost)" DestinationFolder="$(OutDir)host" />
  </Target>
</Project>
