{
  "name": "stephan-os",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "npm run stephanos:dev",
    "build": "npm run stephanos:build",
    "verify": "npm run stephanos:verify",
    "stephanos": "npm run stephanos:ignite:launcher-root",
    "stephanos:launcher-root": "npm run stephanos:ignite:launcher-root",
    "stephanos:vite-dev": "npm run stephanos:ignite:vite-dev",
    "stephanos:ignite:launcher-root": "npm run stephanos:serve",
    "stephanos:ignite:vite-dev": "npm run stephanos:dev",
    "stephanos:ignite:battle-bridge:repair": "npm run stephanos:battle-bridge:repair",
    "stephanos:dev": "concurrently \"npm run dev:server\" \"npm run dev:ui\"",
    "stephanos:build": "node scripts/build-stephanos-ui.mjs",
    "stephanos:guard:imports": "node scripts/guard-import-structure.mjs",
    "stephanos:verify": "node scripts/verify-stephanos-dist.mjs",
    "openclaw:stub:start": "node scripts/openclaw-readonly-adapter-stub.mjs",
    "openclaw:stub:status": "node scripts/openclaw-readonly-adapter-status.mjs",
    "openclaw:github": "node scripts/openclaw-github-operator.mjs",
    "openclaw:github:authorize": "node scripts/stephanos-issue-openclaw-github-authorization.mjs",
    "openclaw:github:test": "node --test shared/agents/openClawGitHubOperator.test.mjs shared/agents/openClawGitHubAuthorization.test.mjs shared/agents/openClawGitHubExecutorPreflight.test.mjs",
    "dev:server": "npm --prefix stephanos-server run dev",
    "dev:ui": "npm --prefix stephanos-ui run dev",
    "build:ui": "npm run stephanos:build",
    "prepublishOnly": "npm run stephanos:build && npm run stephanos:verify",
    "stephanos:clean": "node scripts/clean-stephanos-dist.mjs",
    "stephanos:serve": "node scripts/ignite-stephanos-local.mjs",
    "stephanos:backend": "node stephanos-server/server.js",
    "stephanos:precommit": "npm run stephanos:build && npm run stephanos:verify",
    "predeploy": "npm run stephanos:build && npm run stephanos:verify",
    "deploy": "npm run predeploy && echo \"Stephanos dist is verified and ready to publish from apps/stephanos/dist\"",
    "stephanos:guard:scripts": "node scripts/guard-launcher-scripts.mjs",
    "stephanos:battle-bridge:status": "node scripts/battle-bridge-status.mjs",
    "stephanos:battle-bridge:repair": "node scripts/battle-bridge-repair.mjs",
    "stephanos:battle-bridge:autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/install-stephanos-backend-autostart.ps1",
    "stephanos:battle-bridge:autostart:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/status-stephanos-backend-autostart.ps1",
    "stephanos:battle-bridge:autostart:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/uninstall-stephanos-backend-autostart.ps1",
    "openclaw:stub:ensure": "node scripts/openclaw-readonly-adapter-ensure.mjs",
    "test:ui:reality": "node scripts/browser-proof-preflight.mjs && playwright test",
    "stephanos:ignite": "node scripts/run-battle-bridge-ignition.mjs",
    "stephanos:ignite:supervisor": "node scripts/battle-bridge-ignition-supervisor.mjs",
    "stephanos:ignite:auto-publish": "node scripts/ignite-stephanos-local-autopublish.mjs",
    "stephanos:guard:pr-clean": "node scripts/guard-pr-clean.mjs --strict",
    "stephanos:ignite:pr-clean": "node scripts/ignite-stephanos-local.mjs --mode=pr-clean",
    "stephanos:ignite:housekeep": "node scripts/ignite-stephanos-local.mjs --mode=housekeep",
    "stephanos:ignite:housekeep:dry-run": "node scripts/ignite-stephanos-local.mjs --mode=housekeep-dry-run",
    "stephanos:guard:pr-clean:local": "node scripts/guard-pr-clean.mjs --local",
    "stephanos:pr:prepare": "node scripts/guard-pr-clean.mjs --prepare",
    "stephanos:browser-proof": "node scripts/browser-proof-runner.mjs",
    "stephanos:publish-merge": "node scripts/repository-native-publish-merge-lane.mjs",
    "stephanos:approved-merge": "node scripts/repository-native-approved-merge.mjs",
    "stephanos:operator-merge-approval:test": "node --test shared/agents/operatorMergeApprovalGate.test.mjs shared/agents/repositoryNativePublishMergeLane.test.mjs scripts/repository-native-merge-boundary.test.mjs",
    "stephanos:battle-bridge:concierge": "node scripts/battle-bridge-build-concierge-v2.mjs",
    "stephanos:verify:pr-publication": "node scripts/verify-pr-publication.mjs",
    "ignition:readiness": "node scripts/launcher-readiness-report.mjs",
    "stephanos:battle-bridge:repair-ui-4173": "node scripts/battle-bridge-ui-4173-repair.mjs",
    "stephanos:codex-dispatch:mcp": "node scripts/stephanos-codex-dispatch-mcp.mjs",
    "stephanos:codex-dispatch:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/install-stephanos-codex-dispatch-plugin.ps1",
    "stephanos:codex-dispatch:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/status-stephanos-codex-dispatch-plugin.ps1",
    "stephanos:chat:update": "node scripts/stephanos-chat-update.mjs update",
    "stephanos:chat:sync": "node scripts/stephanos-chat-update.mjs sync",
    "stephanos:chat:diagnostics": "node scripts/stephanos-chat-update.mjs diagnostics",
    "stephanos:monitor-multiplexer:test": "node --test shared/agents/monitorMultiplexer.test.mjs",
    "stephanos:monitor-multiplexer:canary:test": "node --test shared/agents/monitorMultiplexerCanary.test.mjs scripts/battle-bridge-monitor-multiplexer-canary.test.mjs",
    "stephanos:runtime-boundary:workbench": "node scripts/runtime-boundary-workbench.mjs",
    "stephanos:runtime-boundary:test": "node --test shared/agents/runtimeBoundaryRegistry.test.mjs shared/agents/dreamRuntimeBoundary.test.mjs scripts/runtime-boundary-workbench.test.mjs scripts/migrate-dream-runtime-boundary.test.mjs",
    "stephanos:dream-boundary:migrate": "node scripts/migrate-dream-runtime-boundary.mjs",
    "stephanos:codex-dispatch:test": "node --test shared/agents/localCodexExecIntegration.test.mjs shared/agents/codexDispatchMcp.test.mjs shared/agents/codexDispatchHostOps.test.mjs shared/agents/stephanosChatUpdate.test.mjs shared/agents/remoteCodexTaskVisibility.test.mjs scripts/remote-codex-task-visibility-observer.test.mjs scripts/remote-codex-github-mirror-publisher.test.mjs scripts/battle-bridge-worker-watchdog-runner.test.mjs",
    "stephanos:exact-head-review:run": "node scripts/exact-head-review-dispatch.mjs",
    "stephanos:exact-head-review:test": "node --test shared/agents/exactHeadReviewDispatchCoordinator.test.mjs",
    "stephanos:provider-neutral-review:test": "node --test shared/agents/providerNeutralReviewV1.test.mjs shared/agents/providerNeutralReviewV1IdentityRegression.test.mjs",
    "stephanos:pr-estate:reconcile": "node scripts/pr-estate-reconcile.mjs",
    "stephanos:pr-estate:test": "node --test shared/agents/prEstateReconciler.test.mjs shared/agents/prEstateCurrentHeadSafetyRegression.test.mjs scripts/pr-estate-reconcile.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@playwright/test": "^1.54.0"
  }
}
